{
  "description": "1.1.0 responsive layout with four displayed outputs (OBS stream not streaming, two streaming, one reconnecting): tall/narrow sizes must stack, wide/short sizes must use the native-style overview and output table. At every size: no value elided, clipped or off-screen, no overlapping labels, no horizontal scroll bar, full text in every shortened label's tooltip.",
  "steps": [
    { "at": 2.0, "action": "create", "id": "A", "type": "full", "name": "aitum_multi_output_YouTube Horizontal", "width": 1280, "height": 720, "bitrate": 2500, "gpu_scale": true },
    { "at": 2.0, "action": "create", "id": "B", "type": "full", "name": "aitum_multi_output_Kick Output", "width": 854, "height": 480, "bitrate": 1200, "gpu_scale": true, "retries": 1000, "retry_delay": 2 },
    { "at": 2.0, "action": "create", "id": "C", "type": "basic", "name": "msd_srt_like_output", "bitrate": 800, "gpu_scale": false },
    { "at": 2.5, "action": "start", "id": "A" },
    { "at": 2.5, "action": "start", "id": "B" },
    { "at": 2.5, "action": "start", "id": "C" },
    { "at": 4.0, "action": "set", "id": "A", "drop_rate": 0.02, "congestion": 0.4 },
    { "at": 6.0, "action": "set", "id": "B", "unreachable": true },
    { "at": 6.2, "action": "disconnect", "id": "B" },

    { "at": 10.0, "action": "show_dock", "width": 260, "height": 900, "x": 60, "y": 30 },
    { "at": 11.0, "action": "checkpoint", "name": "four_rows",
      "expect": {
        "rows": {
          "primary": { "shown": "1", "state": "Idle" },
          "aitum:YouTube Horizontal": { "shown": "1", "state": "Live", "dropped": ">0" },
          "aitum:Kick Output": { "shown": "1", "state": "Reconnecting" },
          "output:msd_srt_like_output|127.0.0.1": { "shown": "1", "state": "Live" }
        },
        "summary": { "rows": "4", "live": "2", "reconnecting": "1" }
      } },
    { "at": 11.5, "action": "probe_layout", "name": "tall-260",
      "expect": { "found": "1", "mode": "0", "side_by_side": "0", "wide": "0", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 11.6, "action": "screenshot", "file": "tall-260.png" },

    { "at": 12.5, "action": "show_dock", "width": 360, "height": 900 },
    { "at": 14.0, "action": "probe_layout", "name": "tall-360",
      "expect": { "found": "1", "mode": "0", "side_by_side": "0", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 14.1, "action": "screenshot", "file": "tall-360.png" },

    { "at": 15.0, "action": "show_dock", "width": 480, "height": 700 },
    { "at": 16.5, "action": "probe_layout", "name": "tall-480",
      "expect": { "found": "1", "mode": "0", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 16.6, "action": "screenshot", "file": "tall-480.png" },

    { "at": 17.5, "action": "show_dock", "width": 700, "height": 400 },
    { "at": 19.0, "action": "probe_layout", "name": "wide-700",
      "expect": { "found": "1", "wide": "1", "mode": "1", "table_columns": ">=4", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 19.1, "action": "screenshot", "file": "wide-700.png" },

    { "at": 20.0, "action": "show_dock", "width": 1000, "height": 260 },
    { "at": 21.5, "action": "probe_layout", "name": "wide-1000",
      "expect": { "found": "1", "wide": "1", "mode": "1", "table_columns": "5", "side_by_side": "1", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 21.6, "action": "screenshot", "file": "wide-1000.png" },

    { "at": 22.5, "action": "show_dock", "width": 1400, "height": 240 },
    { "at": 24.0, "action": "probe_layout", "name": "wide-1400",
      "expect": { "found": "1", "wide": "1", "mode": "1", "table_columns": "5", "side_by_side": "1", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 24.1, "action": "screenshot", "file": "wide-1400.png" },

    { "at": 25.0, "action": "toggle_sections", "expanded": true },
    { "at": 26.0, "action": "probe_layout", "name": "wide-1400-expanded",
      "expect": { "found": "1", "mode": "1", "sections_expanded": ">=3", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0" } },
    { "at": 26.1, "action": "screenshot", "file": "wide-1400-expanded.png" },
    { "at": 27.0, "action": "toggle_sections", "expanded": false },

    { "at": 28.0, "action": "show_dock", "floating": false, "area": "bottom", "height": 280 },
    { "at": 30.0, "action": "probe_dock", "name": "docked-bottom", "expect": { "found": "1", "floating": "0" } },
    { "at": 30.1, "action": "probe_layout", "name": "docked-bottom",
      "expect": { "found": "1", "wide": "1", "mode": "1", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0", "tips_missing": "0" } },
    { "at": 30.2, "action": "screenshot", "file": "docked-bottom.png" },
    { "at": 30.3, "action": "screenshot", "dock": "main", "file": "main-docked-bottom.png" },

    { "at": 31.0, "action": "show_dock", "width": 360, "height": 900, "x": 60, "y": 30 },
    { "at": 32.5, "action": "probe_layout", "name": "back-to-tall",
      "expect": { "found": "1", "mode": "0", "side_by_side": "0", "sections_expanded": ">=3", "values_clipped": "0", "values_elided": "0", "values_offscreen": "0", "hscroll": "0", "overlaps": "0" } },
    { "at": 32.6, "action": "screenshot", "file": "back-to-tall.png" },

    { "at": 33.0, "action": "show_dock", "dock": "statsDock", "width": 1000, "height": 260, "x": 60, "y": 400 },
    { "at": 34.0, "action": "screenshot", "dock": "statsDock", "file": "native-stats-1000.png" },
    { "at": 34.5, "action": "show_dock", "floating": false, "area": "right", "width": 280 },
    { "at": 35.5, "action": "quit" }
  ]
}
