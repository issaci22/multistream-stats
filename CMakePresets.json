{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (OBS 33.0.1 SDK)",
      "description": "Plugin + unit tests, built against OBS 33.0.1 / Qt 6.11.1 with VS 2026",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.26100.0",
      "warnings": {"dev": true, "deprecated": true},
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist",
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "MSD_BUILD_TESTS": true,
        "MSD_BUILD_MOCK_PLUGIN": false
      }
    },
    {
      "name": "windows-x64-dev",
      "inherits": ["windows-x64"],
      "displayName": "Windows x64 dev (plugin + tests + mock-output test plugin)",
      "cacheVariables": {
        "MSD_BUILD_MOCK_PLUGIN": true
      }
    },
    {
      "name": "windows-ci-x64",
      "inherits": ["windows-x64-dev"],
      "displayName": "Windows x64 CI (plugin + tests + mock-output test plugin)",
      "description": "CI build; installs into build_x64/stage, never into dist/",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build_x64/stage"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS Apple Silicon (OBS 33.0.1 SDK)",
      "description": "Plugin + unit tests for macOS 13.0+ on Apple Silicon (arm64)",
      "binaryDir": "${sourceDir}/build_macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "generator": "Xcode",
      "warnings": {"dev": true, "deprecated": true},
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CODESIGN_IDENTITY": "$penv{CODESIGN_IDENT}",
        "CODESIGN_TEAM": "$penv{CODESIGN_TEAM}",
        "CMAKE_COMPILE_WARNING_AS_ERROR": false,
        "MSD_BUILD_TESTS": true,
        "MSD_BUILD_MOCK_PLUGIN": false
      }
    },
    {
      "name": "macos-ci",
      "inherits": ["macos"],
      "displayName": "macOS Apple Silicon CI (plugin + tests + mock-output test plugin)",
      "cacheVariables": {
        "MSD_BUILD_MOCK_PLUGIN": true
      }
    },
    {
      "name": "macos-ci-strict",
      "inherits": ["macos-ci"],
      "displayName": "macOS Apple Silicon CI, warnings as errors (report only)",
      "binaryDir": "${sourceDir}/build_macos_strict",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      }
    },
    {
      "name": "ubuntu-x86_64",
      "displayName": "Ubuntu x86_64 (system OBS 33 + Qt 6)",
      "description": "Plugin + unit tests against the OBS 33 packages from the official PPA",
      "binaryDir": "${sourceDir}/build_x86_64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "warnings": {"dev": true, "deprecated": true},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib/CMAKE_SYSTEM_PROCESSOR-linux-gnu",
        "CMAKE_COMPILE_WARNING_AS_ERROR": false,
        "MSD_BUILD_TESTS": true,
        "MSD_BUILD_MOCK_PLUGIN": false
      }
    },
    {
      "name": "ubuntu-ci-x86_64",
      "inherits": ["ubuntu-x86_64"],
      "displayName": "Ubuntu x86_64 CI (plugin + tests + mock-output test plugin)",
      "cacheVariables": {
        "MSD_BUILD_MOCK_PLUGIN": true
      }
    },
    {
      "name": "ubuntu-ci-strict-x86_64",
      "inherits": ["ubuntu-ci-x86_64"],
      "displayName": "Ubuntu x86_64 CI, warnings as errors (report only)",
      "binaryDir": "${sourceDir}/build_x86_64_strict",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-dev",
      "configurePreset": "windows-x64-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-ci-x64",
      "configurePreset": "windows-ci-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-ci-strict",
      "configurePreset": "macos-ci-strict",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-x86_64",
      "configurePreset": "ubuntu-x86_64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-ci-x86_64",
      "configurePreset": "ubuntu-ci-x86_64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-ci-strict-x86_64",
      "configurePreset": "ubuntu-ci-strict-x86_64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-x64-dev",
      "configurePreset": "windows-x64-dev",
      "configuration": "RelWithDebInfo",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-ci-x64",
      "configurePreset": "windows-ci-x64",
      "configuration": "RelWithDebInfo",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci",
      "configuration": "RelWithDebInfo",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "ubuntu-ci-x86_64",
      "configurePreset": "ubuntu-ci-x86_64",
      "configuration": "RelWithDebInfo",
      "output": {"outputOnFailure": true}
    }
  ]
}
